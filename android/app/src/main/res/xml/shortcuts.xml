<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the ARYA icon: "Talk", "Voice note". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_arya"
        android:shortcutId="talk"
        android:shortcutLongLabel="@string/talk_long"
        android:shortcutShortLabel="@string/talk_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.arya.phone.TalkActivity"
            android:targetPackage="com.arya.phone" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_arya"
        android:shortcutId="voice_note"
        android:shortcutLongLabel="@string/note_long"
        android:shortcutShortLabel="@string/note_short">
        <intent
            android:action="com.arya.phone.RECORD_NOTE"
            android:targetClass="com.arya.phone.VoiceNotesActivity"
            android:targetPackage="com.arya.phone" />
    </shortcut>
</shortcuts>
