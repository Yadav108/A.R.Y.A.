<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the ARYA icon: "Talk". -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_arya"
        android:shortcutId="talk"
        android:shortcutLongLabel="@string/talk_long"
        android:shortcutShortLabel="@string/talk_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="com.arya.phone.TalkActivity"
            android:targetPackage="com.arya.phone" />
    </shortcut>
</shortcuts>
